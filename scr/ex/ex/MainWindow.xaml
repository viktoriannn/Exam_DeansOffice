<Window x:Class="ex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ex"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Введите количество элементов:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox Name="SizeArr" Grid.Column="1" Grid.Row="0"/>
        <Button Name="BtnCreate" Content="Создать" Grid.Column="2" Grid.Row="0" Click="BtnCreate_Click"/>

        <TextBlock Text="Фамилия" Grid.Column="0" Grid.Row="1"/>
        <TextBlock Text="Имя" Grid.Column="1" Grid.Row="1"/>
        <TextBlock Text="№ зачетной книжки" Grid.Column="2" Grid.Row="1"/>

        <TextBox Name="BoxSurname" Grid.Column="0" Grid.Row="2"/>
        <TextBox Name="BoxName" Grid.Column="1" Grid.Row="2"/>
        <TextBox Name="BoxNumberBook" Grid.Column="2" Grid.Row="2"/>

        <Button Name="BtnAdd" Content="Добавить" Grid.Row="3" Grid.ColumnSpan="3" Click="BtnAdd_Click"/>

        <TextBlock Text="Исходный массив" Grid.Column="0" Grid.Row="4"/>
        <TextBlock Text="Отсортированный массив" Grid.Column="2" Grid.Row="4"/>

        <Grid Grid.ColumnSpan="3" Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Фамилия" Width="150"/>
                <TextBlock Text="Имя" Width="80"/>
                <TextBlock Text="№ зачетной книжки" Width="120"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Фамилия" Width="150"/>
                <TextBlock Text="Имя" Width="80"/>
                <TextBlock Text="№ зачетной книжки" Width="120"/>
            </StackPanel>

            <ListBox Name="LstUnsorted" Grid.Column="0" Grid.Row="1" Margin="0,5,5,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Surname}" Width="150"/>
                            <TextBlock Text="{Binding Name}" Width="80"/>
                            <TextBlock Text="{Binding NumberBook}" Width="100"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Name="LstSorted" Grid.Column="1" Grid.Row="1" Margin="5,5,0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Surname}" Width="150"/>
                            <TextBlock Text="{Binding Name}" Width="80"/>
                            <TextBlock Text="{Binding NumberBook}" Width="100"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Button Content="Сортировать" Name="BtnSortSave" Grid.ColumnSpan="3" Grid.Row="6" Click="BtnSortSave_Click"/>
    </Grid>

</Window>

